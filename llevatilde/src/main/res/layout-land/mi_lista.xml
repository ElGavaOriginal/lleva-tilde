<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp" >

    <!-- Title: smaller to take less vertical space -->
    <TextView
        android:id="@+id/textTituloMiLista"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Mi Lista"
        android:textStyle="bold"
        android:textSize="14sp"
        android:gravity="center"
        android:layout_marginBottom="4dp" />

    <!-- Sort buttons: reduced height and spacing -->
    <LinearLayout
        android:id="@+id/layoutSortControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="4dp"
        style="?android:attr/buttonBarButtonStyle">

        <Button
            android:id="@+id/buttonSortAZ"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:text="A-Z"
            android:textStyle="bold"
            android:textSize="12sp"
            android:layout_marginEnd="4dp"
            android:textColor="@color/button_text_red"
            style="?android:attr/buttonBarButtonStyle"/>

        <Button
            android:id="@+id/buttonSortZA"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:text="Z-A"
            android:textStyle="bold"
            android:textSize="12sp"
            android:textColor="@color/button_text_red"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            style="?android:attr/buttonBarButtonStyle"/>

        <Button
            android:id="@+id/buttonSortDate"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:text="Reciente"
            android:textStyle="bold"
            android:textSize="12sp"
            android:textColor="@color/button_text_red"
            android:layout_marginStart="4dp"
            style="?android:attr/buttonBarButtonStyle"/>

    </LinearLayout>

    <!-- RecyclerView: weight=1 gives it all remaining vertical space -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewMiLista"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingTop="2dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"/>

    <!-- Bottom buttons: compact, no large padding -->
    <LinearLayout
        android:id="@+id/layoutBottomButtons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="4dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        style="?android:attr/buttonBarButtonStyle">

        <Button
            android:id="@+id/buttonBorrarTodo"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:text="Borrar Lista"
            android:textStyle="bold"
            android:textSize="12sp"
            android:layout_marginEnd="6dp"
            android:textColor="@color/button_text_blue"
            style="?android:attr/buttonBarButtonStyle"/>

        <Button
            android:id="@+id/buttonCerrar"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:text="Cerrar"
            android:textStyle="bold"
            android:textSize="12sp"
            android:textColor="@color/button_text_blue"
            android:layout_marginStart="6dp"
            style="?android:attr/buttonBarButtonStyle"/>

    </LinearLayout>
</LinearLayout>
