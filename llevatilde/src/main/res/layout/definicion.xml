<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp" >

        <TextView
            android:id="@+id/textTituloDefinicion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/textTituloDefinicion"
            android:textSize="24sp"
            android:textStyle="bold|italic"
            android:gravity="center"
            android:layout_marginBottom="20dp" />

        <TextView
            android:id="@+id/textInstruccionDefinicion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/textInstruccionDefinicion"
            android:textSize="16sp"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <EditText
                android:id="@+id/editTextPalabraDefinicion"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/editTextPalabraDefinicion"
                android:inputType="textCapWords"
                android:importantForAutofill="no" />

            <ImageButton
                android:id="@+id/buttonMic"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginStart="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/buttonMic"
                android:padding="3dp"
                android:scaleType="fitCenter"
                android:src="@android:drawable/ic_btn_speak_now" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            style="?android:attr/buttonBarStyle">

            <Button
                android:id="@+id/buttonBuscarLinguee"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/buttonBuscarLinguee"
                android:textStyle="bold"
                android:textSize="18dp"
                android:textColor="@color/button_text_blue"
                android:layout_marginEnd="6dp"
                style="?android:attr/buttonBarButtonStyle"/>

            <Button
                android:id="@+id/buttonCerrar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/buttonCerrar"
                android:textStyle="bold"
                android:textSize="18dp"
                android:textColor="@color/button_text_blue"
                android:layout_marginStart="6dp"
                style="?android:attr/buttonBarButtonStyle"/>

        </LinearLayout>
    </LinearLayout>
</ScrollView>