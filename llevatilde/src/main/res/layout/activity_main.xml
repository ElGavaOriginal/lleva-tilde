<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true" >

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp">

        <Button
            android:id="@+id/buttonWidget"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/buttonWidget"
            android:textSize="25sp"
            android:textStyle="bold"
            android:textColor="@color/button_text_blue"
            android:background="@android:color/transparent"
            android:padding="8dp"
            android:layout_marginTop="9dp"
            android:layout_marginStart="9dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <Button
            android:id="@+id/buttonInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/buttonInfo"
            android:textSize="16sp"
            android:textColor="@color/button_text_blue"
            android:background="@android:color/transparent"
            android:gravity="center"
            android:padding="8dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="12dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/textWelcomeBanner"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="80dp"
            android:gravity="center"
            android:text="@string/textWelcomeBanner"
            android:textAlignment="center"
            android:textSize="20sp"
            android:textStyle="italic|bold"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/textWelcomeSubtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:gravity="center"
            android:text="@string/textWelcomeSubtitle"
            android:textAlignment="center"
            android:textSize="16sp"
            android:textStyle="italic"
            android:paddingStart="25dp"
            android:paddingEnd="20dp"
            app:layout_constraintTop_toBottomOf="@id/textWelcomeBanner"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <LinearLayout
            android:id="@+id/mainButtonContainer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="70dp"
            android:orientation="vertical"
            android:gravity="center"
            app:layout_constraintTop_toBottomOf="@+id/textWelcomeSubtitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            style="?android:attr/buttonBarStyle">

            <Button
                android:id="@+id/buttonLlevaTilde"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginStart="28dp"
                android:layout_marginEnd="28dp"
                android:layout_marginBottom="18dp"
                android:text="@string/buttonLlevaTilde"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="@color/button_text_blue"
                style="?android:attr/buttonBarButtonStyle"/>

            <Button
                android:id="@+id/buttonMiLista"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginStart="28dp"
                android:layout_marginEnd="28dp"
                android:layout_marginBottom="18dp"
                android:text="@string/buttonMilista"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="@color/button_text_blue"
                style="?android:attr/buttonBarButtonStyle"/>

            <Button
                android:id="@+id/buttonLasReglas"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginStart="28dp"
                android:layout_marginEnd="28dp"
                android:layout_marginBottom="18dp"
                android:text="@string/buttonLasReglas"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="@color/button_text_blue"
                style="?android:attr/buttonBarButtonStyle"/>

            <Button
                android:id="@+id/buttonDefinicion"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginStart="28dp"
                android:layout_marginEnd="28dp"
                android:layout_marginBottom="18dp"
                android:text="@string/buttonDefinicion"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="@color/button_text_blue"
                style="?android:attr/buttonBarButtonStyle"/>

            <Button
                android:id="@+id/buttonSalir"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginStart="28dp"
                android:layout_marginEnd="28dp"
                android:layout_marginBottom="18dp"
                android:text="@string/buttonSalir"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="@color/button_text_blue"
                style="?android:attr/buttonBarButtonStyle"/>

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>